# ==========================================
# Backend Environment Variables (Server / Vercel Backend)
# ==========================================
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# - Local: mongodb://localhost:27017/ats-app (or omitted to use auto In-Memory DB)
# - Vercel Production: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ats-app?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ats-app

# CORS Allowed Frontend Origin
# - Local: http://localhost:5173
# - Vercel Production: https://mini-ats-one.vercel.app
CLIENT_URL=https://mini-ats-one.vercel.app

# Optional JWT Secret
JWT_SECRET=your-jwt-secret-here-change-in-production

# ==========================================
# Frontend Environment Variables (Client / Vercel Frontend)
# ==========================================
# Base URL for the backend API (set in Vercel Frontend project settings)
# - Local: leave blank to use Vite dev proxy
# - Vercel Production: https://mini-ats-tfil.vercel.app/api
VITE_API_BASE_URL=https://mini-ats-tfil.vercel.app/api
